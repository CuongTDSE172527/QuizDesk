    <OutputType>WinExe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable>
    <AssemblyName>QuizDesk</AssemblyName><Version>5.11.0</Version>
    <RuntimeIdentifiers>win-x64;osx-arm64;osx-x64</RuntimeIdentifiers>
    <ApplicationIcon>QuizDesk.ico</ApplicationIcon><RestorePackagesPath>../.packages</RestorePackagesPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../QuizDesk.Mobile/QuizDesk.Mobile.csproj" />
