<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable>
    <ApplicationId>com.quizdesk.mobile</ApplicationId><ApplicationTitle>QuizDesk</ApplicationTitle>
    <ApplicationVersion>60106</ApplicationVersion><ApplicationDisplayVersion>5.16.1</ApplicationDisplayVersion>
    <AndroidPackageFormats>apk</AndroidPackageFormats><AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <RunAOTCompilation>false</RunAOTCompilation><PublishTrimmed>false</PublishTrimmed>
    <AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>
    <!-- Use dynamic JNI registration: Release marshal methods omit the inherited
         AvaloniaAndroidApplication<T>.OnCreate callback with this Android SDK. -->
    <AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <RestorePackagesPath>../.packages</RestorePackagesPath>
    <AndroidManifest>Properties/AndroidManifest.xml</AndroidManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="12.1.4" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.2.0.2" />
    <ProjectReference Include="../QuizDesk.Mobile/QuizDesk.Mobile.csproj" />
  </ItemGroup>
</Project>
